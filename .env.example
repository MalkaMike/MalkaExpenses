# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth — bcrypt hash of admin password (full access at /admin)
ADMIN_PASSWORD_HASH=

# Household auth — bcrypt hash of wife/household password (main site access)
HOUSEHOLD_PASSWORD_HASH=

# Health admin auth — bcrypt hash of Ayelet's password (access to /admin/health)
# Generate: node -e "const b=require('bcryptjs');console.log(b.hashSync('password',10))"
HEALTH_PASSWORD_HASH=

# Secretary auth — bcrypt hash of Celina's password (access to /admin/health/queue only)
# Generate: node -e "const b=require('bcryptjs');console.log(b.hashSync('password',10))"
CELINA_PASSWORD_HASH=

# Cookie signing key (random 32+ bytes, hex) — used for all auth tiers
MODE_COOKIE_SECRET=

# Admin session timeout (sliding window, minutes; household/health/secretary are 90 days)
ADMIN_TIMEOUT_MINUTES=60

# AI providers
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=

# Open Finance (Pluggy) — auto bank sync. Get these at dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Shared secret guarding the webhook; set the same token on the Pluggy dashboard
# webhook URL: https://<your-app>/api/pluggy/webhook?token=THIS_VALUE
PLUGGY_WEBHOOK_SECRET=
# Secret for the daily Vercel cron that auto-syncs connected banks. Set this in
# Vercel env; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Gmail OAuth — for nota fiscal lookup + auto-email to Celina
# Requires scope: gmail.readonly + gmail.send
# Re-consent at /api/auth/gmail/connect after any scope change
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_NAME=Casa

# ── Supabase Storage ─────────────────────────────────────────────────────────
# Create these buckets in the Supabase dashboard (Storage → New bucket).
# All buckets must be PRIVATE (no public access). Names:
#   nota-fiscais         — NFS-e PDFs
#   medical-documents    — prescriptions / pedidos / laudos
#   insurance-vault      — policy PDFs (APRIL and future)
#   claim-attachments    — generated claim summaries (future)
#
# Then run the one-time migration:
#   node scripts/migrate_files_to_supabase.mjs
#
# SUPABASE_SERVICE_ROLE_KEY (above) is used by the migration script and all
# storage reads — no extra env var needed.
