# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth — bcrypt hash of admin password (full access at /admin)
ADMIN_PASSWORD_HASH=

# Household auth — bcrypt hash of wife/household password (main site access)
HOUSEHOLD_PASSWORD_HASH=

# Cookie signing key (random 32+ bytes, hex) — used for both auth tiers
MODE_COOKIE_SECRET=

# Admin session timeout (sliding window, minutes; household is 90 days)
ADMIN_TIMEOUT_MINUTES=60

# AI providers
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=Casa
