MODE_COOKIE_SECRET=

# Admin session timeout (sliding window, minutes)
ADMIN_TIMEOUT_MINUTES=60

# AI providers
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=Casa
