{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/pluggy-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/gmail-search",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/weekly-snapshot",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/health-outbox",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/pluggy-webhook-migrate",
      "schedule": "4 17 * * *"
    }
  ],
  "functions": {
    "app/api/cron/weekly-snapshot/route.ts": { "maxDuration": 120 },
    "app/api/cron/gmail-search/route.ts": { "maxDuration": 300 },
    "app/api/cron/health-outbox/route.ts": { "maxDuration": 90 }
  }
}
